# Copy this file to `.env` and set only the providers/models you use.

# API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional model overrides (defaults are defined in `loveletter/ai_agent.py`)
LITELLM_MODEL_OPENAI=openai/gpt-4o-mini
LITELLM_MODEL_ANTHROPIC=anthropic/claude-sonnet-4-5
LITELLM_MODEL_GEMINI=gemini/gemini-2.5-flash-lite
LITELLM_MODEL_XAI=xai/grok-3-mini
